---
import Footer from "@components/Footer.astro";
import { NavBar } from "../solid/Navbar.jsx";
import SpeedInsights from "@vercel/speed-insights/astro";
import "../styles/global.css";

export interface Props {
  title: string;
  brief: string; // Add this lin
  url: string; // Add this line
  words: string; // Add this line
}

const { title, brief, url, words } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width" name="viewport" />
    <meta content={Astro.generator} name="generator" />
    <!-- <link rel="icon" href="/favicon.ico" /> -->
    <link href="/favicon.ico" rel="icon" type="image/svg+xml" />
    <!-- <link href="/favicon.png" rel="icon" type="image/svg+xml" /> -->

    <title>{title}</title>

    <!-- HTML Meta Tags -->
    <meta name="keywords" content={words} />
    <meta name="description" content={brief} />

    <!--content=""-->
    <!-- Normal Meta Tags -->
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={brief} />
    <meta property="og:image" content="https://salam.app/image.png" />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="salam.app" />
    <meta property="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={brief} />
    <meta name="twitter:image" content="https://salam.app/image.png" />
    <SpeedInsights />
    <!-- HTML Meta Tags -->
    <style is:global>
      @import "../styles/global.css";
    </style>
  </head>
  <body class="bg-[#21252f] bg-smoke-400">
    <NavBar client:load />
    <div class="h-screen flex absolute align-middle">
      <img class="fixed z-[-1000] h-5/6 opacity-5" src="/icon.svg" />
    </div>
    <slot />
    <Footer />
  </body>
</html>
