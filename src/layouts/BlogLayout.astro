---
// Import the NavBar component
import { NavBar } from "../solid/Navbar.jsx";
import Footer from "@components/Footer.astro";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.ico" rel="icon" type="image/svg+xml" />

    <title>{Astro.props.title}</title>

    <meta
      name="description"
      content={Astro.props.metaData || "Default description"}
    />

    <meta property="og:url" content={Astro.props.link || "https://salam.app"} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={Astro.props.title} />
    <meta
      property="og:description"
      content={Astro.props.metaData || "Default description"}
    />
    <meta
      property="og:image"
      content={Astro.props.metaImage || "https://salam.app/image.png"}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="salam.app" />
    <meta
      property="twitter:url"
      content={Astro.props.link || "https://salam.app"}
    />
    <meta name="twitter:title" content={Astro.props.title} />
    <meta
      name="twitter:description"
      content={Astro.props.metaData || "Default description"}
    />
    <meta
      name="twitter:image"
      content={Astro.props.metaImage || "https://salam.app/image.png"}
    />
    <meta name="keywords" content={Astro.props.words || "salam,app"} />

  </head>
  <body>
    <NavBar client:load />

    <main class="page-shell flex justify-center">
      <div
        class="prose prose-invert prose-base max-w-3xl px-4 py-16 prose-headings:tracking-tight prose-headings:text-white prose-h1:text-4xl prose-h1:font-semibold prose-h2:mt-16 prose-h2:text-2xl prose-h2:font-semibold prose-h2:text-white prose-h3:text-xl prose-a:text-[var(--accent)] prose-a:no-underline hover:prose-a:underline prose-blockquote:border-l-[var(--accent)] prose-blockquote:font-serif sm:px-8 sm:py-24"
      >
        <div
          class="prose-img:rounded-2xl prose-img:border prose-img:border-[var(--line)] sm:prose-img:mx-auto sm:prose-img:w-1/2"
        >
          <div
            class="bg-aquamarine-600 rounded-r-full h-1 left-0 w-0 fixed top-0 z-50"
            id="progressBar"
          >
          </div>
          <>
            <slot />
          </>
        </div>
      </div>
    </main>
    <Footer />
  </body>

  <script>
    window.addEventListener("scroll", function () {
      var winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      var height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      var scrolled = (winScroll / height) * 100;

      document.getElementById("progressBar").style.width = scrolled + "%";
    });
  </script>
</html>
