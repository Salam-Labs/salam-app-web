---
const { title, image, brief, link } = Astro.props;
---

<div
  class="max-w-[320px] border-gray-200 rounded-lg hover:shadow bg-gray-800 hover:bg-smoke-500 m-4 transform translate-y-0 hover:-translate-y-5 transition-transform duration-300"
>
  <a href={link}>
    <div class="">
      <img
        class="rounded-t-lg h-[180px] w-[320px]"
        src={image}
        alt={title}
        loading="lazy"
      />
    </div>
    <div class="px-3 py-2 text-center">
      <h5 class="mb-2 text-2xl font-bold tracking-tight text-white">
        {title}
      </h5>
      <p class="mb-3 font-normal text-gray-400">{brief}</p>
    </div>
  </a>
</div>
