---
const { title, image, brief, link } = Astro.props;
---

<article class="motion-rise surface group w-full overflow-hidden rounded-xl transition hover:-translate-y-1 hover:border-[var(--accent)]">
  <a href={link} class="block h-full">
    <img
      class="h-48 w-full object-cover transition duration-500 group-hover:scale-[1.02]"
      src={image}
      alt={title}
      loading="lazy"
    />
    <div class="p-5">
      <h2 class="text-lg font-semibold tracking-tight text-white">{title}</h2>
      <p class="mt-2 line-clamp-3 text-sm leading-6 text-[var(--muted)]">{brief}</p>
      <span class="mt-4 inline-flex items-center text-sm font-semibold text-[var(--accent)]">
        Read article <span class="ml-2 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</article>
