---
const stats = [
  {
    endValue: "100000",
    increment: "1",
    duration: "3000",
    label: "+ Downloads",
  },
  { endValue: "4.8", increment: ".1", duration: "3000", label: "+ Ratings" },
  { endValue: "900", increment: "1", duration: "3000", label: "+ Reviews" },
];
---

<div class="flex justify-center items-center text-white">
  <div
    class="flex flex-col py-16 overflow-hidden lg:py-24 justify-center items-center"
  >
    <div class="mx-auto max-w-2xl md:text-center mb-4">
      <h2
        id="testimonials-stats"
        class="font-display font-bold text-3xl text-center tracking-tight text-white sm:text-4xl"
      >
        Statistics.
      </h2>
      <p class="mt-4 text-white text-lg tracking-tight" id="stats">
        Great reception from Muslims worldwide.
      </p>
    </div>

    <div
      class="mt-4 grid grid-cols-1 gap-10 px-6 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        stats.map((stat) => (
          <div
            class="relative group shadow-sm w-full cursor-pointer select-none"
            style="min-width: 340px;"
          >
            <div class="absolute -inset-1 bg-gradient-to-r from-aquamarine-600 to-indigo-500 rounded-lg blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200" />
            <div class="relative bg-smoke-400 ring-1 ring-gray-900/5 rounded-lg leading-none flex items-top justify-start space-x-9 border-2 border-aquamarine">
              <figure class="relative p-5 h-full w-full">
                <div class="flex justify-center items-center space-x-2 w-full">
                  <div class="flex flex-none items-center justify-center h-12 w-12 rounded-full bg-aquamarine text-black mr-2">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      height="30px"
                      viewBox="0 0 24 24"
                    >
                      <path
                        fill="currentColor"
                        d="M14.75 15c.966 0 1.75.784 1.75 1.75l-.001.962c.117 2.19-1.511 3.297-4.432 3.297c-2.91 0-4.567-1.09-4.567-3.259v-1c0-.966.784-1.75 1.75-1.75h5.5Zm-11-5h4.376a4.007 4.007 0 0 0 1.067 3.85l.162.151L9.25 14a2.75 2.75 0 0 0-2.649 2.008l-.034.001C3.657 16.009 2 14.919 2 12.75v-1c0-.966.784-1.75 1.75-1.75Zm16.5 0c.966 0 1.75.784 1.75 1.75l-.001.962c.117 2.19-1.511 3.297-4.432 3.297l-.169-.002a2.756 2.756 0 0 0-2.451-2L14.75 14l-.105.001a3.99 3.99 0 0 0 1.229-4L20.25 10ZM12 8a3 3 0 1 1 0 6a3 3 0 0 1 0-6ZM6.5 3a3 3 0 1 1 0 6a3 3 0 0 1 0-6Zm11 0a3 3 0 1 1 0 6a3 3 0 0 1 0-6Z"
                      />
                    </svg>
                  </div>
                  <div class="flex flex-1 text-white items-center justify-start gap-1.5 whitespace-nowrap">
                    <p
                      class="font-semibold number-animate"
                      data-end-value={stat.endValue}
                      data-increment={stat.increment}
                      data-duration={stat.duration}
                    >
                      0
                    </p>
                    <p class="font-semibold">{stat.label}</p>
                  </div>
                </div>
              </figure>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  import { animate, utils } from "animejs";

  function startCounter() {
    document.querySelectorAll(".number-animate").forEach((element) => {
      const { endValue } = element.dataset;
      const incrementValue = element.dataset.increment;
      const durationValue = element.dataset.duration;
      if (endValue) {
        numberAnimation(element, endValue, incrementValue, durationValue);
      }
    });
  }

  function numberAnimation(element, endValue, incrementor, duration) {
    animate(element, {
      textContent: endValue,
      modifier: incrementor
        ? utils.round(Math.log10(1 / incrementor))
        : utils.round(1),
      ease: "outQuad",
      duration: duration || 4000,
    });
  }

  const intersectionObserver = new IntersectionObserver((entries) => {
    if (entries[0].intersectionRatio <= 0) {
      return;
    }
    startCounter();
    intersectionObserver.unobserve(document.querySelector("#stats"));
  });

  intersectionObserver.observe(document.querySelector("#stats"));
</script>
