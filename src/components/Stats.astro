---
const stats = [
  {
    endValue: "100000",
    increment: "1",
    duration: "3000",
    label: "Downloads",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M5 20h14v-2H5v2Zm9-9h3l-5 5-5-5h3V3h4v8Z"/></svg>`,
  },
  {
    endValue: "4.8",
    increment: ".1",
    duration: "3000",
    label: "Rating",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="m12 2 2.94 5.95 6.56.95-4.75 4.63 1.12 6.54L12 17l-5.87 3.07 1.12-6.54L2.5 8.9l6.56-.95L12 2Z"/></svg>`,
  },
  {
    endValue: "900",
    increment: "1",
    duration: "3000",
    label: "Reviews",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20 2H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h4l4 3 4-3h4a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Zm-2 12H6v-2h12v2Zm0-4H6V8h12v2Z"/></svg>`,
  },
];
---

<section class="border-y border-[var(--line)] text-white" id="stats">
  <div class="page-shell py-20 lg:py-24">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">
        Community snapshot
      </p>
      <h2
        id="testimonials-stats"
        class="mt-4 text-4xl font-semibold tracking-[-0.03em] text-white sm:text-5xl"
      >
        Statistics.
      </h2>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      {
        stats.map((stat, index) => (
          <article class="motion-rise surface flex min-h-[230px] flex-col rounded-3xl p-6 sm:p-8">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--muted)]">
                0{index + 1}
              </span>
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--surface-raised)] text-[var(--accent)]">
                <Fragment set:html={stat.icon} />
              </span>
            </div>
            <div class="mt-auto pt-12">
              <div class="flex items-baseline gap-0 text-white">
                <p
                  class="number-animate text-5xl font-semibold tracking-[-0.04em]"
                  style={`width: ${stat.endValue.length + 1}ch`}
                  data-end-value={stat.endValue}
                  data-increment={stat.increment}
                  data-duration={stat.duration}
                >
                  0+
                </p>
              </div>
              <p class="mt-2 text-sm font-semibold uppercase tracking-[0.16em] text-[var(--muted)]">
                {stat.label}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  function startCounter() {
    document.querySelectorAll(".number-animate").forEach((element) => {
      const endValue = Number(element.dataset.endValue);
      const increment = Number(element.dataset.increment);
      const duration = Number(element.dataset.duration) || 4000;
      const precision = increment > 0 ? Math.max(0, Math.ceil(-Math.log10(increment))) : 0;
      const startTime = performance.now();

      function updateCounter(now) {
        const progress = Math.min((now - startTime) / duration, 1);
        const easedProgress = 1 - (1 - progress) ** 2;
        element.textContent = `${(endValue * easedProgress).toFixed(precision)}+`;

        if (progress < 1) {
          requestAnimationFrame(updateCounter);
        }
      }

      requestAnimationFrame(updateCounter);
    });
  }

  const statsTarget = document.querySelector("#stats");
  if (statsTarget && "IntersectionObserver" in window) {
    const intersectionObserver = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) {
        return;
      }
      startCounter();
      intersectionObserver.disconnect();
    });

    intersectionObserver.observe(statsTarget);
  } else {
    startCounter();
  }
</script>
