---
import { Modal } from "../solid/Modal.jsx";
---

<section class="border-b border-[var(--line)]">
  <div
    class="mx-auto grid max-w-6xl items-center gap-16 px-6 py-16 sm:px-8 sm:py-24 lg:grid-cols-[1.05fr_0.95fr] lg:px-10 lg:py-28"
  >
    <div class="motion-rise max-w-2xl">
      <a
        href="/release/2.0.0"
        class="mb-8 inline-flex items-center rounded-full border border-[var(--line)] px-3 py-1.5 text-sm font-medium text-[var(--accent)] hover:border-[var(--accent)]"
      >
        <span aria-hidden="true">✦</span>
        <span class="ml-2">Salam App 2.0 is here</span>
        <span class="ml-2" aria-hidden="true">→</span>
      </a>

      <h1 class="text-5xl font-semibold leading-[0.95] tracking-[-0.06em] text-white sm:text-7xl lg:text-8xl">
        A calmer way to
        <span class="text-[var(--accent)]">practice.</span>
      </h1>
      <div class="mt-10 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
        <Modal client:idle />
      </div>

      <dl class="mt-12 grid max-w-lg grid-cols-3 gap-5 border-t border-[var(--line)] pt-5">
        <div>
          <dt class="text-xs font-medium uppercase tracking-[0.18em] text-[var(--muted)]">Ads</dt>
          <dd class="mt-1 text-lg font-semibold text-white">Never</dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-[0.18em] text-[var(--muted)]">Privacy</dt>
          <dd class="mt-1 text-lg font-semibold text-white">By default</dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-[0.18em] text-[var(--muted)]">Price</dt>
          <dd class="mt-1 text-lg font-semibold text-white">Free</dd>
        </div>
      </dl>
    </div>

    <div class="motion-rise flex justify-center lg:justify-end">
      <div class="rounded-[2.5rem] border border-[var(--line)] bg-[var(--surface)] p-3 shadow-2xl shadow-black/20">
        <img
          src="/theme5.png"
          class="h-[560px] w-[296px] rounded-[2rem] object-cover sm:h-[640px] sm:w-[338px]"
          alt="Salam App prayer tracker screen"
        />
      </div>
    </div>
  </div>
</section>
