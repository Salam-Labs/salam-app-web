---
import CiLike from "~icons/mdi/like";
import CiDislike from "~icons/mdi/dislike";
---

<div class="flex justify-center my-16 sm:p-10">
  <div
    class="shadow-lg shadow-aquamarine-500 sm:w-8/12 flex rounded-2xl justify-center border-2 border-aquamarine-500"
  >
    <div class="">
      <h6 id="feedback-message" class="p-4 text-center">
        Did you find this article helpful?
      </h6>
      <div class="flex justify-around items-center" id="buttons">
        <!-- inside this is the buttons -->
        <CiLike id="like-button" class="hover:text-aquamarine-500 text-4xl" />
        <CiDislike
          id="dislike-button"
          class="hover:text-aquamarine-500 text-4xl"
        />
      </div>
      <h6 id="votes" class="text-sm p-4 text-center">
        <span id="people-liked">0</span> People found this useful.
      </h6>
    </div>
    <!--this is the w-2/3 inside this is p and a div  -->
  </div>
</div>

<script is:inline>
  async function likeDislike(url, action) {
    try {
      if (action !== "like" && action !== "dislike") {
        throw new Error('Action must be either "like" or "dislike"');
      }

      const response = await fetch(
        "https://salam-app-backend-397370f119cb.herokuapp.com/like-dislike",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "x-api-key": "ioiojweroo23io23oikl",
          },
          body: JSON.stringify({ url: url, number: 1, type: action }),
        },
      );

      if (!response.ok) {
        throw new Error("Failed to perform the action");
      }

      const data = await response.json();
      console.log(data);
      updatePeopleLiked();
    } catch (error) {
      console.error("Error:", error.message);
    }
  }

  async function updatePeopleLiked() {
    try {
      const response = await fetch(
        "https://salam-app-backend-397370f119cb.herokuapp.com/likes-dislikes",
      );
      if (!response.ok) {
        throw new Error("Failed to fetch likes-dislikes data");
      }

      const data = await response.json();
      console.log(data);

      const currentPageURL = window.location.pathname
        .split("/")
        .filter((segment) => segment !== "")
        .pop();

      const currentPageData = data.find(
        (entry) => entry.url === currentPageURL,
      );

      if (!currentPageData) {
        throw new Error("Data for current page not found");
      }

      document.getElementById("people-liked").textContent =
        currentPageData.likes;
    } catch (error) {
      console.error("Error:", error.message);
    }
  }

  const likeButton = document.getElementById("like-button");
  const dislikeButton = document.getElementById("dislike-button");
  const feedbackMessage = document.getElementById("feedback-message");

  likeButton.addEventListener("click", async () => {
    document.getElementById("like-button").classList.add("hidden");
    document.getElementById("dislike-button").classList.add("hidden");
    feedbackMessage.textContent =
      "Jazakallah Khairan! (May Allah reward you abundantly with goodness.)";

    const urlToCheck = window.location.pathname
      .split("/")
      .filter((segment) => segment !== "")
      .pop();
    await likeDislike(urlToCheck, "like");
  });

  dislikeButton.addEventListener("click", async () => {
    document.getElementById("like-button").classList.add("hidden");
    document.getElementById("dislike-button").classList.add("hidden");
    feedbackMessage.textContent =
      "Jazakallah Khairan! (May Allah reward you abundantly with goodness.)";
    const urlToCheck = window.location.pathname
      .split("/")
      .filter((segment) => segment !== "")
      .pop();
    await likeDislike(urlToCheck, "dislike");
  });

  window.onload = async function () {
    await updatePeopleLiked();
  };
</script>
