---
const toolkit = [
  {
    index: "01",
    label: "READ DEEPLY",
    title: "Quran & Hadith",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" aria-hidden="true"><path fill="currentColor" d="M128 24a104 104 0 1 0 104 104A104.1 104.1 0 0 0 128 24Zm0 192a88 88 0 1 1 88-88a88.1 88.1 0 0 1-88 88Zm16-40a8 8 0 0 1-8 8h-8a8 8 0 0 1-8-8v-48a8 8 0 0 1 0-16h8a8 8 0 0 1 8 8v48Zm-30-92a12 12 0 1 1 12 12a12 12 0 0 1-12-12Z"/></svg>`,
  },
  {
    index: "02",
    label: "STAY PRESENT",
    title: "Notifications",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 22c1.1 0 2-.9 2-2h-4a2 2 0 0 0 2 2Zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5S9.5 3.17 9.5 4v.68C7.63 5.36 6 7.92 6 11v5l-1.29 1.29c-.63.63-.19 1.71.7 1.71h13.17c.89 0 1.34-1.08.71-1.71L18 16Z"/></svg>`,
  },
  {
    index: "03",
    label: "MAKE IT YOURS",
    title: "Themes",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2C6.49 2 2 6.49 2 12s4.49 10 10 10a2.5 2.5 0 0 0 1.86-4.17a.5.5 0 0 1 .37-.83H16c3.31 0 6-2.69 6-6c0-4.96-4.49-9-10-9Zm-5.5 11a1.5 1.5 0 1 1 0-3a1.5 1.5 0 0 1 0 3Zm3-4a1.5 1.5 0 1 1 0-3a1.5 1.5 0 0 1 0 3Zm5 0a1.5 1.5 0 1 1 0-3a1.5 1.5 0 0 1 0 3Zm4.5 2.5a1.5 1.5 0 1 1 0-3a1.5 1.5 0 0 1 0 3Z"/></svg>`,
  },
];

const quranModes = [
  {
    id: "verse",
    image: "quran7.png",
    label: "Verse by Verse",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M26 30h-2V20H12v10h-2V20a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2zM5.17 16 2 19.17l1.41 1.42L8 16l-4.58-4.58L2 12.83 5.17 16ZM24 14H12a2 2 0 0 1-2-2V2h2v10h12V2h2v10a2 2 0 0 1-2 2Z"/></svg>`,
  },
  {
    id: "mushaf",
    image: "quran5.png",
    label: "Mushaf Mode",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21 5c-1.11-.35-2.33-.5-3.5-.5c-1.95 0-4.05.4-5.5 1.5c-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v15.5C2.45 20.4 4.55 20 6.5 20s4.05.4 5.5 1.5c1.45-1.1 3.55-1.5 5.5-1.5c1.17 0 2.39.15 3.5.5c.75.25 1.4.55 2 1V6c-.6-.45-1.25-.75-2-1Zm0 13.5c-1.1-.35-2.3-.5-3.5-.5c-1.7 0-4.15.65-5.5 1.5V8c1.35-.85 3.8-1.5 5.5-1.5c1.2 0 2.4.15 3.5.5v11.5Z"/></svg>`,
  },
  {
    id: "list",
    image: "quran3.png",
    label: "List Mode",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 10.5a1.5 1.5 0 1 0 0 3a1.5 1.5 0 0 0 0-3Zm0-6a1.5 1.5 0 1 0 0 3a1.5 1.5 0 0 0 0-3Zm0 12a1.5 1.5 0 1 0 0 3a1.5 1.5 0 0 0 0-3ZM7 19h14v-2H7v2Zm0-6h14v-2H7v2Zm0-8v2h14V5H7Z"/></svg>`,
  },
];
---

<section class="overflow-hidden py-20 lg:py-28">
  <div class="page-shell">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">
        The Salam toolkit
      </p>
      <h2 class="mt-4 max-w-xl text-4xl font-semibold tracking-[-0.03em] text-white sm:text-5xl">
        A focused toolkit for everyday practice
      </h2>
    </div>

    <div class="mt-12 grid gap-4 lg:mt-16 lg:grid-cols-3">
      {
        toolkit.map((item) => (
          <article
            class="motion-rise surface flex min-h-[260px] flex-col rounded-3xl p-6 sm:p-8"
          >
            <div class="flex items-start justify-between gap-4">
              <span class="text-4xl font-semibold tracking-[-0.04em] text-white">
                {item.index}
              </span>
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--surface-raised)] text-[var(--accent)]">
                <Fragment set:html={item.icon} />
              </span>
            </div>

            <div class="mt-auto max-w-md pt-12">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--muted)]">
                {item.label}
              </p>
              <h3 class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-3xl">
                {item.title}
              </h3>
            </div>
          </article>
        ))
      }
    </div>

    <div
      class="mt-6 grid overflow-hidden rounded-3xl border border-[var(--line)] bg-[var(--surface)] lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]"
      id="quran"
    >
      <div class="p-6 sm:p-8 lg:flex lg:flex-col lg:justify-center lg:p-10">
        <div class="flex items-center justify-between gap-4">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">
            Quran reader
          </p>
          <span class="text-xs font-medium uppercase tracking-[0.16em] text-[var(--muted)]">
            03 modes
          </span>
        </div>

        <h3 class="mt-8 max-w-md text-4xl font-semibold tracking-[-0.03em] text-white sm:text-5xl">
          The Holy Quran
        </h3>
        <div class="mt-8 space-y-2">
          {
            quranModes.map((mode) => (
              <button
                type="button"
                class="flex min-h-[76px] w-full items-center gap-4 rounded-2xl border border-transparent p-3 text-left"
                id={mode.id}
                aria-pressed="false"
                onclick={`changePic('${mode.image}', '${mode.id}')`}
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[var(--surface-raised)] text-[var(--accent)]">
                  <Fragment set:html={mode.icon} />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="text-base font-semibold text-white">{mode.label}</span>
                </span>
                <span class="text-lg text-[var(--muted)]" aria-hidden="true">
                  →
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="relative flex min-h-[520px] items-end justify-center overflow-hidden bg-[var(--surface-raised)] p-6 sm:min-h-[600px] lg:min-h-[680px] lg:p-10">
        <img
          id="img"
          src="/quran1.png"
          class="h-auto w-full max-w-[345px] drop-shadow-2xl"
          alt="Salam App Quran reader preview"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .selected {
    background-color: var(--surface-raised);
    border-color: var(--accent);
  }
</style>

<script is:inline>
  function changePic(pic, id) {
    document.querySelector("#img").src = `/${pic}`;

    const idNames = ["verse", "list", "mushaf"];

    idNames.forEach(function removeClass(item) {
      const element = document.getElementById(item);
      element.classList.remove("selected");
      element.setAttribute("aria-pressed", "false");
    });

    const selected = document.getElementById(id);
    selected.classList.add("selected");
    selected.setAttribute("aria-pressed", "true");
  }

  changePic("quran5.png", "mushaf");
</script>
