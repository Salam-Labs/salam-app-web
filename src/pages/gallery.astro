---
import Layout from "@layouts/Layout.astro";

const sections = [
  {
    id: "quran-tafsir",
    eyebrow: "Read and listen",
    title: "Quran",
    description:
      "Keep the Quran close with flexible reading modes, recitations, translations, and tafsir.",
    points: [
      "Verse by verse, Mushaf, and List modes",
      "Tafsir, audio, transliteration, bookmarks, and translation",
    ],
    images: [
      ["/quran7.png", "Quran verse mode"],
      ["/quran1.png", "Quran home"],
      ["/quran2.png", "Quran reading view"],
      ["/quran3.png", "Quran list mode"],
      ["/quran4.png", "Quran translation"],
      ["/quran5.png", "Quran Mushaf mode"],
      ["/quran6.png", "Quran bookmarks"],
      ["/tafsir1.png", "Tafsir view"],
      ["/tafsir2.png", "Tafsir reading"],
      ["/tafsir3.png", "Tafsir details"],
      ["/tafsir4.png", "Tafsir notes"],
    ],
  },
  {
    id: "hadith",
    eyebrow: "Learn with context",
    title: "Hadith",
    description:
      "Explore trusted collections and keep useful references available throughout your day.",
    points: [
      "Seven Sahih books and more",
      "Hisn Al Muslim, Bulugh Al Maram, Riyadh As Salihin, and more",
    ],
    images: [
      ["/hadith1.png", "Hadith home"],
      ["/hadith2.png", "Hadith collection"],
      ["/hadith3.png", "Hadith reader"],
      ["/hadith4.png", "Hadith details"],
    ],
  },
  {
    id: "prayertimes-themes",
    eyebrow: "Stay on time",
    title: "Prayer times",
    description:
      "Accurate prayer times, clear reminders, Hijri dates, and a choice of calm visual themes.",
    points: [
      "Prayer times, Tahajjud, Adhan notifications, and Hijri date",
      "Default, Rashidun, Pastel, Classic, and Ayyubid themes",
    ],
    images: [
      ["/prayerTime1.png", "Prayer times home"],
      ["/prayerTime2.png", "Prayer time details"],
      ["/prayerTime3.png", "Prayer notifications"],
      ["/prayerTime4.png", "Prayer settings"],
      ["/prayerTime5.png", "Prayer times list"],
      ["/theme1.png", "Default theme"],
      ["/theme2.png", "Rashidun theme"],
      ["/theme3.png", "Pastel theme"],
      ["/theme4.png", "Classic theme"],
      ["/theme5.png", "Ayyubid theme"],
    ],
  },
  {
    id: "99names-qibla",
    eyebrow: "Keep discovering",
    title: "And more",
    description:
      "Small tools that make daily practice easier, from the Qibla compass to personal tracking.",
    points: [
      "99 Names of Allah, Prayer Tracker, Qibla Compass, and Islamic Calendar",
      "Dua collections and practical reminders",
    ],
    images: [
      ["/99names1.png", "99 Names of Allah"],
      ["/99names2.png", "99 Names list"],
      ["/99names3.png", "99 Names details"],
      ["/qiblaCompass1.png", "Qibla compass"],
      ["/calender1.png", "Islamic calendar"],
      ["/dua1.png", "Dua collection"],
      ["/dua2.png", "Dua details"],
      ["/prayerTracker.png", "Prayer tracker"],
    ],
  },
];
---

<Layout
  title="Salam App Gallery"
  brief="Images of Salam Apps modules and features."
  url="https://salam.app/gallery"
  words="salam,app,help,gallery,photos,images"
>
  <main class="page-shell pb-24">
    <header class="mx-auto max-w-3xl py-16 text-center sm:py-24">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-[var(--accent)]">See it in action</p>
      <h1 class="mt-4 text-5xl font-semibold tracking-[-0.05em] text-white sm:text-7xl">A calmer toolkit for every day.</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-[var(--muted)]">Browse the features that make Salam App useful without getting in your way.</p>
    </header>

    <div>
      {sections.map((section, index) => (
        <section id={section.id} class={`grid scroll-mt-20 items-center gap-12 border-t border-[var(--line)] py-16 sm:py-24 lg:grid-cols-[minmax(0,1fr)_22rem] ${index % 2 === 1 ? "lg:grid-cols-[22rem_minmax(0,1fr)]" : ""}`}>
          <div class={index % 2 === 1 ? "lg:order-2" : ""}>
            <p class="text-sm font-medium uppercase tracking-[0.18em] text-[var(--accent)]">{section.eyebrow}</p>
            <h2 class="mt-3 text-4xl font-semibold tracking-tight text-white sm:text-5xl">{section.title}</h2>
            <p class="mt-5 max-w-xl text-lg leading-8 text-[var(--muted)]">{section.description}</p>
            <ul class="mt-8 space-y-4 text-base leading-7 text-white">
              {section.points.map((point) => <li class="flex gap-3"><span class="mt-2 h-2 w-2 flex-none rounded-full bg-[var(--accent)]" aria-hidden="true"></span><span>{point}</span></li>)}
            </ul>
          </div>

          <div class={`motion-rise surface relative mx-auto w-full max-w-[22rem] rounded-[2rem] p-3 ${index % 2 === 1 ? "lg:order-1" : ""}`}>
            <div class="swiper mySwiper overflow-hidden rounded-[1.5rem]">
              <div class="swiper-wrapper">
                {section.images.map(([src, alt], imageIndex) => (
                  <img src={src} alt={alt} class="swiper-slide h-[38rem] w-full object-contain" loading={index === 0 && imageIndex === 0 ? "eager" : "lazy"} />
                ))}
              </div>
              <div class="swiper-pagination"></div>
            </div>
          </div>
        </section>
      ))}
    </div>
  </main>
</Layout>

<script>
  import Swiper from "swiper";
  import { Pagination, Autoplay } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/pagination";

  document.querySelectorAll(".mySwiper").forEach((element) => {
    const pagination = element.querySelector(".swiper-pagination");
    new Swiper(element, {
      autoplay: { delay: 2400, pauseOnMouseEnter: true },
      loop: true,
      pagination: { el: pagination, clickable: true },
      modules: [Pagination, Autoplay],
    });
  });
</script>
