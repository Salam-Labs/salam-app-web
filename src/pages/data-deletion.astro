---
import Layout from "@layouts/Layout.astro";
import CiTrash from "~icons/ph/trash-bold";

// Updated Backend URL
const BACKEND_URL =
  "https://sa-data-deletion-request-e6ce70303653.herokuapp.com";
---

<Layout
  title="Data Deletion Request"
  brief="Delete all your data and backup in Salam App."
  url="https://salam.app/data-deletion"
  words="salam,app,data,deletion"
>
  <div class="relative p-10 sm:px-36">
    <div id="main-form">
      <h1
        class="text-left sm:text-center text-3xl sm:text-5xl text-aquamarine font-bold mb-10 sm:mb-16"
      >
        Data Deletion
      </h1>
      <p class="mb-5 text-lg text-white">
        User data is only stored if Salam App Cloud is used to create a backup;
        if you wish for all user data to be deleted, please solve the reCAPTCHA
        and then enter the e-mail linked to your account in the field below.
        When the trash icon becomes active, press it.
      </p>
      <b class="text-red-500">This action is irreversible.</b>

      <div
        class="g-recaptcha mt-5"
        data-sitekey="6Ldm02QpAAAAAL0_vVUB7nesbM4Yn8QT8OxBfa1E"
        data-callback="onRecaptchaCallback"
      >
      </div>

      <label for="email" class="block mt-5 text-sm font-medium text-white"
        >Your email :</label
      >
      <div class="flex mt-1">
        <input
          type="email"
          id="email"
          class="border text-sm rounded-lg block w-full p-2.5 bg-gray-700 border-gray-600 text-white focus:ring-aquamarine focus:border-aquamarine"
          placeholder="example@gmail.com"
          required
        />

        <button
          id="submit-button"
          class="bg-gray-500 cursor-not-allowed opacity-50 rounded-md px-4 mx-5 transition-all duration-200 enabled:bg-red-600 enabled:opacity-100 enabled:cursor-pointer"
          onclick="remove()"
          disabled
        >
          <CiTrash name="ph:trash-bold" class="w-5 h-5 text-white" />
        </button>
      </div>

      <div class="flex">
        <p class="mt-2 text-sm text-gray-400">
          We’ll never share your details. Please read our
          <a
            href="/privacy-policy"
            class="text-aquamarine-500 mt-2 ml-1 hover:underline text-sm"
          >
            Privacy Policy.
          </a>
        </p>
      </div>
    </div>

    <div id="mail-sent-view" class="hidden text-center">
      <h1 class="text-5xl text-aquamarine font-bold mb-16">
        Please check your mail
      </h1>
      <p class="mb-10 text-lg text-white">
        A confirmation link has been sent to your e-mail. Please click the link
        in your mail account to confirm your data deletion request.
      </p>
      <h1 class="text-aquamarine font-bold mb-16">Check spam folder too.</h1>
    </div>

    <div id="success-view" class="hidden text-center">
      <h1 class="text-5xl text-aquamarine font-bold mb-16">SUCCESS</h1>
      <p class="mb-10 text-lg text-white">
        Your data deletion request has been submitted; all your user data will
        be removed within the next few days. You can re-enable the sync feature
        by logging into Salam App, but old data will be irretrievable.
      </p>
      <h1 class="text-aquamarine font-bold mb-16">
        You may close this window.
      </h1>
    </div>
  </div>

  <script src="https://www.google.com/recaptcha/api.js" async defer></script>

  <script is:inline define:vars={{ BACKEND_URL }}>
    // Wake up the server
    fetch(`${BACKEND_URL}/heartbeat`, {
      method: "POST",
      headers: { "Content-Type": "text/plain" },
      body: "awake",
    }).catch(() => {});

    let solvedCaptcha = false;
    let token = null;

    // Callback function to handle reCAPTCHA completion
    window.onRecaptchaCallback = function (response) {
      token = response;
      solvedCaptcha = true;
      validateForm();
    };

    function validateEmail(email) {
      const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      return re.test(email);
    }

    function validateForm() {
      const email = document.getElementById("email").value;
      const button = document.getElementById("submit-button");

      if (validateEmail(email) && solvedCaptcha) {
        button.disabled = false;
      } else {
        button.disabled = true;
      }
    }

    // Monitor email input for changes
    document.getElementById("email").addEventListener("input", validateForm);

    async function remove() {
      const email = document.getElementById("email").value;
      const button = document.getElementById("submit-button");

      // Disable button to prevent double submission
      button.disabled = true;

      try {
        const response = await fetch(`${BACKEND_URL}/delete`, {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams({ email, token }),
        });

        if (response.ok) {
          document.getElementById("main-form").classList.add("hidden");
          document.getElementById("mail-sent-view").classList.remove("hidden");
        } else {
          alert("Error submitting request. Please check your connection.");
          button.disabled = false;
        }
      } catch (err) {
        console.error("Submission error:", err);
        button.disabled = false;
      }
    }

    // Handle Success redirect check
    if (window.location.href.includes("#success")) {
      document.getElementById("main-form").classList.add("hidden");
      document.getElementById("mail-sent-view").classList.add("hidden");
      document.getElementById("success-view").classList.remove("hidden");
    }
  </script>
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
