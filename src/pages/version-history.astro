---
import Layout from "@layouts/Layout.astro";

const data = [
{
    version: "2.0.6",
    date: "Sep 5, 2026",
    heading: "Introducing Salam App 2.0.6!",
    brief:
      "This release improves the reliability of Quran reading and audio, prayer times, location, reminders, backups, onboarding, and everyday app performance.",
  },

    {
    version: "2.0.0",
    date: "Jun 30, 2026",
    heading: "Introducing Salam App 2.0.0!",
    brief:
      "This release rebuilds Salam App from the 1.0 experience with a refreshed interface, improved reliability, expanded content systems, and a smoother daily workflow.",
  },
  {
    version: "1.3.1",
    date: "Oct 13, 2024",
    heading: "Introducing Salam App 1.3.1!",
    brief:
      "This is a maintenance update with fixes, a few small feature additions, and quality of life improvements.",
  },
  {
    version: "1.3.0",
    date: "Mar 11, 2024",
    heading: "Introducing Salam App 1.3.0!",
    brief:
      "This update brings many exciting features, including Cloud backup and the Reminder Swipe Module.",
  },

  {
    version: "1.2.0",
    date: "Jun 15, 2023",
    heading: "Introducing Salam App 1.2.0!",
    brief:
      "This update enhances prayer auto-detection for more accurate times and includes various fixes and improvements.",
  },
  {
    version: "1.1.5",
    date: "Mar 24, 2023",
    heading: "Ramadan Mubarak, Salam App 1.1.5 is here!",
    brief:
      "Adding a variety of reminders to help you stay consistent with your ibadah. Some bugs were also fixed.",
  },

  {
    version: "1.1.0",
    date: "Jan 20, 2023",
    heading: "Introducing the Salam App 1.1.0!",
    brief:
      "Based on user feedback, we have added many new features such as Dhikr & Dua, Quran Player, and Islamic Calendar. We have also improved existing features and the user interface, as well as added a brand new theme, the Ayyubid Sultanate.",
  },
  {
    version: "1.0.1",
    date: "Sep 3, 2022",
    heading: "Introducing the Salam App 1.0.1",
    brief:
      "Bug fixes and improvements. Prayer settings auto-detection has been fixed for users in the UK/Hong Kong/and other regions. Check out the Rashidun Caliphate theme!",
  },
  {
    version: "1.0.0",
    date: "Aug 14, 2022",
    heading: "Salam App v1 released on both playstore and appstore",
    brief: "May Allah (swt) help us maintain the app.",
  }
];
---

<Layout
  title="Salam App Changelog"
  brief="Changes to Salam App. A page where we post blogs on what changed and future features."
  url="https://salam.app/version-history"
  words="salam,app,help,artciles,blog"
>
  <main class="page-shell pb-24">
    <header class="mx-auto max-w-3xl py-16 text-center sm:py-24">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-[var(--accent)]">What’s new</p>
      <h1 class="mt-4 text-5xl font-semibold tracking-[-0.05em] text-white sm:text-7xl">Version history.</h1>
      <p class="mt-6 text-lg leading-8 text-[var(--muted)]">A clear record of the work behind every release.</p>
    </header>
    {
      data.map((item) => (
        <div class="motion-rise mb-5">
          <a
            href={`release/${item.version}`}
            class="surface mx-auto flex w-full items-start justify-between gap-6 rounded-2xl p-6 hover:-translate-y-1 hover:border-[var(--accent)] sm:p-8"
          >
            <div class="flex min-w-0 flex-1 flex-col justify-between leading-normal">
              <div class="flex flex-wrap items-center gap-3">
                <span class="rounded-full border border-[var(--line)] px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-[var(--accent)]">{item.version}</span>
                <span class="text-sm text-[var(--muted)]">{item.date}</span>
              </div>
              <h2 class="mb-3 mt-4 text-2xl font-semibold tracking-tight text-white sm:text-3xl">
                {item.heading}
              </h2>
              <p class="text-base leading-7 text-[var(--muted)]">{item.brief}</p>
            </div>
            <span class="hidden shrink-0 text-2xl text-[var(--accent)] sm:block" aria-hidden="true">→</span>
          </a>
        </div>
      ))
    }
  </main>
</Layout>
