---
import Card from "@components/Card.astro";
import Layout from "@layouts/Layout.astro";
import CiSearch from "~icons/mingcute/search-3-line";
import CiDiscord from "~icons/ic/baseline-discord";
import { data as blogData } from "../../public/searchData.json";

//data here dont delete because if load more is not clicked then these are shown
---

<Layout title="Salam App Blog">
  <!-- js and css part 1 -->

  <script is:inline>
    const blogData = [];

    // Function to fetch JSON data and populate blogData.
    function fetchDataAndPopulateSuggestions() {
      fetch("/searchData.json")
        .then((response) => response.json())
        .then((data) => {
          // Access the 'data' property of the JSON object
          const dataArray = Array.isArray(data.data)
            ? data.data
            : Object.values(data.data);
          blogData.push(...dataArray);
        })
        .catch((error) => {
          console.error("Error loading data:", error);
        });
    }

    // Call the function to fetch and populate the blogData array.
    fetchDataAndPopulateSuggestions();

    // Function to handle input changes and display suggestions.
    function handleInput() {
      const input = document.querySelector("input");
      const inputValue = input.value.toLowerCase();
      const suggestionList = document.querySelector(
        "#suggestion-list-container",
      );

      // Clear previous suggestions.
      suggestionList.innerHTML = "";

      if (inputValue.trim() === "") {
        // If the input is empty or only whitespace, hide the suggestion list and return.
        suggestionList.classList.add("hidden");
        return;
      }

      // Filter and display up to 5 suggestions that match the input value or brief text.
      const matchingSuggestions = blogData
        .filter((suggestion) => {
          return (
            suggestion.title.toLowerCase().includes(inputValue) ||
            suggestion.brief.toLowerCase().includes(inputValue)
          );
        })
        .slice(0, 5); // Get up to 5 matching suggestions.

      if (matchingSuggestions.length === 0) {
        // If no suggestions match the input, hide the suggestion list.
        suggestionList.classList.add("hidden");
        return;
      }

      matchingSuggestions.forEach((suggestion) => {
        const suggestionItem = document.createElement("div");
        suggestionItem.innerHTML = `
        <a href="${suggestion.link}" class="block text-white focus:bg-smoke-500 focus:outline-none focus:rounded-lg">
  <div class="hover:rounded-lg flex hover:bg-smoke-500 transition-all duration-300">
    <div class="hidden sm:block flex justify-center items-center sm:min-w-5/6"> 
      <img class=" rounded-l-xl align-middle" src="${suggestion.image}" height="250px" width="500px">
    </div>
    <div class="sm:w-full">
      <p class="p-2 text-white text-xl font-bold tracking-tight sm:min-w-200">${suggestion.title}</p>
      <p class="p-2 text-base text-gray-400 max-h-20 overflow-hidden sm:min-w-200">${suggestion.brief}</p>
    </div>
  </div>
</a>


    `;

        suggestionList.appendChild(suggestionItem);
      });

      // Show the suggestion list.
      suggestionList.classList.remove("hidden");
    }
  </script>
  <!-- js and css part 1 closes -->
  <!-- html starts from here  suggestion container and card has 10 mt -->
  <section id="section" class="text-white body-font mb-36 w-full">
    <h1
      class="text-5xl mt-16 sm:text-5xl font-bold text-center text-aquamarine-500"
      id="texteffect"
    >
      Help Center
    </h1>
    <div class="flex justify-center items-center mt-16">
      <div class="relative w-11/12 sm:w-8/12 lg:w-[610px]">
        <input
          placeholder="Search"
          class="w-full p-1 px-2 focus:outline-none rounded-lg text-2xl text-gray-200 bg-grey-500 border-2 border-aquamarine-500"
          type="text"
          oninput="handleInput()"
        />
        <CiSearch
          class="absolute right-0 bottom-0 mr-0 text-[35px] rounded-r-lg bg-aquamarine-500 text-black"
        />
      </div>
    </div>
    <div class="flex justify-center w-full">
      <div
        id="suggestion-list-container"
        class="hidden absolute z-10 mt-10 w-11/12 sm:w-8/12 lg:w-[610px] rounded-lg text-2xl text-gray-200 border-2 bg-smoke-400 border-aquamarine-500"
      >
      </div>
    </div>
    <h2 class="text-2xl text-center font-bold mt-16">
      Facing an Issue? We've Got You Covered!
    </h2>
    <p class="mt-8 text-center text-lg w-full px-2 sm:px-12 lg:px-56">
      Explore our support resources for app modules and settings. If you're new
      to Salam App, find helpful tips in our articles. For direct assistance,
      join our Discord support server.
    </p>
    <!-- auto complete and input tag above   -->
    <!-- cards here  -->
    <div id="cards" class="flex flex-wrap justify-center my-16">
      <!-- Loop through the blogData array and create a card for each suggestion -->
      {
        blogData.map((data) => (
          // card here
          <Card
            title={data.title}
            image={data.image}
            brief={data.brief}
            link={data.link}
          />
        ))
      }
    </div>

    <!-- <div class="flex justify-center">
        <button
          id="load-more-button"
          class="px-5 py-2 mt-5 bg-aquamarine-600 text-black rounded-lg hover:bg-aquamarine-700 focus:ring-4 focus:outline-none focus:ring-blue-300"
        >
          Load More
        </button> -->

    <div class="fixed bottom-0 right-0 m-4 z-50">
      <a
        href="https://discord.com/invite/bKqvBtD"
        target="_blank"
        class="flex items-center p-2 border-4 border-aquamarine-500 text-lg rounded-full text-aquamarine-500 hover:shadow bg-gray-800 hover:bg-smoke-500 m-4 transform duration-300"
      >
        <CiDiscord class="text-xl m-1" />
        <p>Get Support</p>
      </a>
    </div>
  </section>
</Layout>
<!-- This is for text effect -->
<script is:inline>
  const suggestionList = document.getElementById("suggestion-list-container");

  // Hide suggestion list container on click outside
  document.addEventListener("click", (event) => {
    const isClickInside = suggestionList.contains(event.target);
    if (!isClickInside) {
      suggestionList.classList.add("hidden");
    }
  });
</script>
