---
import Card from "@components/Card.astro";
import Layout from "@layouts/Layout.astro";
import CiSearch from "~icons/mingcute/search-3-line";
import CiDiscord from "~icons/ic/baseline-discord";
import { data as blogData } from "../../public/searchData.json";
---

<Layout
  title="Salam App Help Center"
  brief="Search for articles on how to use Salam Apps modules"
  url="https://salam.app/help-center"
  words="salam,app,help,artciles,blog"
>
  <style is:inline>
    .search-container {
      background-color: #21252f !important;
      border: 1px solid #66fcf1;
      border-radius: 10px;
      margin: 10px;
      position: relative;
    }

    .search-results {
      position: absolute;
      left: auto;
      right: auto;
      z-index: 10;
      margin-top: 10px;
      border: 2px solid #66fcf1;
      border-radius: 8px;
      background-color: #1e2939;
      color: #ccc;
    }
    .search-item {
      padding: 8px;
      cursor: pointer;
      display: block;
      transition: background-color 0.3s ease;
    }

    .search-item a {
      display: flex;
      align-items: center;
      text-decoration: none;
      color: inherit;
    }


    .search-item-text {
      flex-grow: 1;
    }

    .search-item:hover {
      background-color: #101217 !important;
    }
  </style>

  <script is:inline>
    // This function now handles both search suggestions and displaying full results.
    function handleInput() {
      const input = document.querySelector("input");
      const inputValue = input.value.toLowerCase();
      const suggestionList = document.querySelector(
        "#suggestion-list-container"
      );
      const cardsContainer = document.querySelector("#cards");
      const noResultsText = document.querySelector("#no-results-text");

      // Hide no results text by default.
      noResultsText.classList.add("hidden");

      if (inputValue.trim() === "") {
        // If the input is empty, hide suggestion list and show initial cards.
        suggestionList.classList.add("hidden");
        cardsContainer.innerHTML = `
          ${blogData
            .map(
              (data) => `
            <div class="m-2">
              <Card title="${data.title}" image="${data.image}" brief="${data.brief}" link="${data.link}" />
            </div>
          `
            )
            .join("")}
        `;
        return;
      }

      // Fetch the search data directly.
      fetch("/searchData.json")
        .then((response) => response.json())
        .then((data) => {
          const searchData = Array.isArray(data.data)
            ? data.data
            : Object.values(data.data);

          const matchingSuggestions = searchData
            .filter((suggestion) => {
              return (
                suggestion.title.toLowerCase().includes(inputValue) ||
                suggestion.brief.toLowerCase().includes(inputValue)
              );
            })
            .slice(0, 5); // Get up to 5 matching suggestions.

          suggestionList.innerHTML = "";
          if (matchingSuggestions.length > 0) {
            // Display suggestions in the dropdown.
            matchingSuggestions.forEach((suggestion) => {
              const suggestionItem = document.createElement("div");
              suggestionItem.classList.add("search-item");
              suggestionItem.innerHTML = `
                <a href="${suggestion.link}">
                  <div class="flex">
                    <img class="rounded-l-xl align-middle hidden sm:block" src="${suggestion.image}" height="300px" width="300px">
                    <div class="search-item-text">
                      <p class="p-2 text-white text-xl font-bold tracking-tight">${suggestion.title}</p>
                      <p class="p-2 text-base text-gray-400 max-h-20 overflow-hidden">${suggestion.brief}</p>
                    </div>
                  </div>
                </a>
              `;
              suggestionList.appendChild(suggestionItem);
            });
            suggestionList.classList.remove("hidden");
          } else {
            suggestionList.classList.add("hidden");
          }
        })
        .catch((error) => {
          console.error("Error loading data:", error);
        });
    }

    // Function to handle Enter key press for search
    function handleSearch(event) {
      if (event.key === "Enter") {
        const input = document.querySelector("input");
        const inputValue = input.value.toLowerCase();
        const cardsContainer = document.querySelector("#cards");
        const noResultsText = document.querySelector("#no-results-text");
        const suggestionList = document.querySelector(
          "#suggestion-list-container"
        );

        // Hide suggestions and clear previous cards
        suggestionList.classList.add("hidden");
        cardsContainer.innerHTML = "";
        noResultsText.classList.add("hidden");

        if (inputValue.trim() === "") {
          cardsContainer.innerHTML = `
            ${blogData
              .map(
                (data) => `
              <div class="m-2">
                <Card title="${data.title}" image="${data.image}" brief="${data.brief}" link="${data.link}" />
              </div>
            `
              )
              .join("")}
          `;
          return;
        }

        fetch("/searchData.json")
          .then((response) => response.json())
          .then((data) => {
            const searchData = Array.isArray(data.data)
              ? data.data
              : Object.values(data.data);
            const matchingResults = searchData.filter((item) => {
              return (
                item.title.toLowerCase().includes(inputValue) ||
                item.brief.toLowerCase().includes(inputValue)
              );
            });

            if (matchingResults.length === 0) {
              noResultsText.classList.remove("hidden");
            } else {
              noResultsText.classList.add("hidden");
              matchingResults.forEach((data) => {
                const card = document.createElement("div");
                card.innerHTML = `<astro-island component-export="default" renderer-mode="client:load" props='{"title":"${data.title}","image":"${data.image}","brief":"${data.brief}","link":"${data.link}"}' uid="2h8Tq" prerender></astro-island>`;
                cardsContainer.appendChild(card);
              });
            }
          })
          .catch((error) => {
            console.error("Error loading data:", error);
          });
      }
    }
  </script>
  <section id="section" class="text-white body-font mb-36 w-full">
    <h1
      class="text-5xl mt-16 sm:text-5xl font-bold text-center text-aquamarine-500"
      id="texteffect"
    >
      Help Center
    </h1>
    <div class="flex justify-center items-center mt-16">
      <div class="relative w-11/12 sm:w-8/12 lg:w-[610px]">
        <input
          placeholder="Search"
          class="w-full p-1 px-2 focus:outline-none rounded-lg text-2xl text-gray-200 bg-grey-500 border-2 border-aquamarine-500"
          type="text"
          oninput="handleInput()"
          onkeydown="handleSearch(event)"
        />
        <CiSearch
          class="absolute right-0 bottom-0 mr-0 text-[35px] rounded-r-lg bg-aquamarine-500 text-black"
        />
      </div>
    </div>
    <div class="flex justify-center w-full">
      <div
        id="suggestion-list-container"
        class="hidden absolute z-10 w-11/12 sm:w-8/12 lg:w-[610px] search-results"
      >
      </div>
    </div>
    <h2 class="text-2xl text-center font-bold mt-16">
      Facing an Issue? We've Got You Covered!
    </h2>
    <p class="mt-8 text-center text-lg w-full px-2 sm:px-12 lg:px-56">
      Explore our support resources for app modules and settings. If you're new
      to Salam App, find helpful tips in our articles. For direct assistance,
      join our Discord support server.
    </p>
    <div
      id="no-results-text"
      class="hidden mt-16 text-center text-lg text-gray-400"
    >
      No results found. Please try a different search query.
    </div>
    <div id="cards" class="flex flex-wrap justify-center my-16">
      {
        blogData.map((data) => (
          <Card
            title={data.title}
            image={data.image}
            brief={data.brief}
            link={data.link}
          />
        ))
      }
    </div>

    <div class="fixed bottom-0 right-0 m-4 z-50">
      <a
        href="https://discord.com/invite/bKqvBtD"
        target="_blank"
        class="flex items-center p-2 border-4 border-aquamarine-500 text-lg rounded-full text-aquamarine-500 hover:shadow bg-gray-800 hover:bg-smoke-500 m-4 transform duration-300"
      >
        <CiDiscord class="text-xl m-1" />
        <p>Get Support</p>
      </a>
    </div>
  </section>
</Layout>

<script is:inline>
  const suggestionList = document.getElementById("suggestion-list-container");
  const input = document.querySelector("input");

  // Hide suggestion list container on click outside
  document.addEventListener("click", (event) => {
    const isClickInside =
      suggestionList.contains(event.target) || input.contains(event.target);
    if (!isClickInside) {
      suggestionList.classList.add("hidden");
    }
  });
</script>
