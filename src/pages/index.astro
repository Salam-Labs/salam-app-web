---
import Features from "@components/Features.astro";
import Hero from "@components/Hero.astro";
import Stats from "@components/Stats.astro";
import Layout from "@layouts/Layout.astro";
import WordBubble from "src/components/WordBubble.astro";
import { Testimonials } from "src/solid/Testimonials";
---

<Layout
  title="Salam App : Islamic Prayer App with Salah, Quran & more"
  brief="Salam App is an advertisement-free and privacy-focused Islamic app that offers all the features a Muslim needs without compromises, for free! "
  url="https://salam.app"
  words="salam,app,islamic,prayer,app "
>
  <Hero />
  <WordBubble />
  <Features />
  <Stats />
  <Testimonials client:idle />
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
