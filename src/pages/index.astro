---
import Features from "@components/Features.astro";
import Hero from "@components/Hero.astro";
import Stats from "@components/Stats.astro";
import Layout from "@layouts/Layout.astro";
import WordBubble from "src/components/WordBubble.astro";
import { Testimonials } from "src/solid/Testimonials";
---

<meta name="description" content="A islamic prayer app with many features developed by volunteers">
<meta property="og:title" content="Salam App " />
<meta property="og:url" content="https://salam.app/" />
<meta property="og:description" content="A privacy friendly islamic prayer app" />
<Layout title="Salam App">
  <Hero />
  <WordBubble />
  <Features />
  <Stats />
  <Testimonials client:idle />
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
