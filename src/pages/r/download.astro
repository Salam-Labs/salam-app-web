<div class="h-screen w-screen bg-smoke-400"></div>

<script is:inline>
  function getMobileOperatingSystem() {
    var userAgent = navigator.userAgent || navigator.vendor || window.opera;

    if (/android/i.test(userAgent)) {
      window.location.replace(
        "https://play.google.com/store/apps/details?id=com.salamlabs.salamapp",
      );
      return 0;
    }

    // iOS detection from: http://stackoverflow.com/a/9039885/177710
    else if (/iPad|iPhone|iPod/.test(userAgent) && !window.MSStream) {
      window.location.replace(
        "https://apps.apple.com/app/id1629159763?platform=iphone",
      );
      return 0;
    }

    alert("The App is only available in Android and IOS");
    document.location.href = "/";
    return 0;
  }
  getMobileOperatingSystem();
</script>
